{
  "manifest_version": 3,
  "name": "Agent Web Browser",
  "version": "1.0.0",
  "description": "供本机 Agent 使用的浏览器连接，保留已有登录与标签页。",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": ["debugger", "nativeMessaging", "tabs", "storage", "alarms"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Agent Web Browser", "default_popup": "popup.html" }
}
